# Copy to .env.e2e.local; the local file is ignored by Git.
# Use two dedicated, confirmed accounts and separate disposable resources for each identity.
# Leave blank until a value is configured locally; never copy production credentials here.
E2E_API_URL=http://127.0.0.1:5000
E2E_SUPABASE_EMAIL=
E2E_SUPABASE_PASSWORD=""
E2E_SUPABASE_SECONDARY_EMAIL=
E2E_SUPABASE_SECONDARY_PASSWORD=""

# Required to complete the unconfirmed-account scenario; keep it unconfirmed in Supabase Auth.
E2E_SUPABASE_UNCONFIRMED_EMAIL=
E2E_SUPABASE_UNCONFIRMED_PASSWORD=""

# Separate groups, portfolios and positions owned by each confirmed account.
E2E_SUPABASE_PRIMARY_GROUP_ID=
E2E_SUPABASE_PRIMARY_PORTFOLIO_ID=
E2E_SUPABASE_PRIMARY_POSITION_ID=
E2E_SUPABASE_SECONDARY_GROUP_ID=
E2E_SUPABASE_SECONDARY_PORTFOLIO_ID=
E2E_SUPABASE_SECONDARY_POSITION_ID=
